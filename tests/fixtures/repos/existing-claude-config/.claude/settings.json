{
  "permissions": {
    "allow": ["Bash(uv run pytest:*)"],
    "deny": ["Read(./secrets/**)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hooks/custom-safety.py"
          }
        ]
      }
    ]
  },
  "env": {
    "PAYMENTS_ENV": "development"
  }
}
